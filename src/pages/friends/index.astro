---
import PageLayout from '@layouts/PageLayout.astro'
import { SITE } from '@consts'

const friends = [
  {
    name: 'Dogxi 的狗窝',
    href: 'https://dogxi.me/',
    description: 'Dogxi 的个人博客，因为热爱所以热爱。',
    avatar: 'https://dogxi.me/avatar.png',
  },
  {
    name: 'Astro',
    href: 'https://astro.build/',
    description: 'The web framework for content-driven websites.',
    avatar: 'https://astro.build/favicon.svg',
  },
  {
    name: 'Tailwind CSS',
    href: 'https://tailwindcss.com/',
    description: 'Rapidly build modern websites without leaving your HTML.',
    avatar: 'https://tailwindcss.com/favicons/favicon-32x32.png',
  },
]
const siteUrl = Astro.site?.toString() || 'https://xiaozhubao.top/'
---

<PageLayout title="友链" description="一些有趣的网站。">
  <h1>友链</h1>
  <ul class="friend-list">
    {
      friends.map((friend) => (
        <li>
          <a href={friend.href} target="_blank" rel="noopener noreferrer">
            <>
              <img
                src={friend.avatar}
                alt=""
                width="40"
                height="40"
                loading="lazy"
              />
              <div>
                <>
                  <h2>
                    {friend.name} <span>↗</span>
                  </h2>
                  <p>{friend.description}</p>
                </>
              </div>
            </>
          </a>
        </li>
      ))
    }
  </ul>
  <details>
    <summary>申请友链 <span aria-hidden="true">+</span></summary><div
      class="friend-details"
    >
      <p>欢迎交换友链，可以在留言板或 GitHub 联系我。</p><dl>
        <dt>名称</dt><dd>{SITE.NAME}</dd><dt>链接</dt><dd>{siteUrl}</dd><dt>
          描述
        </dt><dd>{SITE.DESCRIPTION}</dd><dt>RSS</dt><dd>
          {new URL('rss.xml', siteUrl).toString()}
        </dd>
      </dl><a href="/messages">去留言板 ↗</a>
    </div>
  </details>
</PageLayout>

<style>
  h1 {
    font-size: 28.8px;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: 36px;
  }
  li {
    border-top: 1px solid var(--line);
  }
  li:last-child {
    border-bottom: 1px solid var(--line);
  }
  li a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 0;
  }
  img {
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  h2 {
    font-size: 15px;
    font-weight: 600;
  }
  h2 span {
    color: var(--muted);
    font-size: 12px;
  }
  p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
    margin-top: 4px;
  }
  details {
    margin-top: 40px;
    font-size: 14px;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] summary span {
    transform: rotate(45deg);
  }
  .friend-details {
    padding-top: 20px;
  }
  dl {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 10px;
    margin: 20px 0;
  }
  dt {
    color: var(--muted);
  }
  dd {
    overflow-wrap: anywhere;
  }
</style>
