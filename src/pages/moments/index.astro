---
import { getCollection, render } from 'astro:content'
import PageLayout from '@layouts/PageLayout.astro'
import BlogNav from '@components/BlogNav.astro'
import { THOUGHTS } from '@consts'

const collection = (await getCollection('thoughts'))
  .filter((thought) => !thought.data.draft)
  .sort(
    (first, second) => second.data.date.valueOf() - first.data.date.valueOf(),
  )
const moments = await Promise.all(
  collection.map(async (moment) => ({ ...moment, ...(await render(moment)) })),
)
---

<PageLayout title="Moments" description={THOUGHTS.DESCRIPTION}>
  <BlogNav />
  <h1 class="sr-only">Moments</h1>
  {
    moments.map(({ data, Content }) => (
      <section class="moment">
        <time datetime={data.date.toISOString()}>
          {data.date.toLocaleDateString('zh-CN')}
        </time>
        <article>
          <Content />
        </article>
        {data.tags && (
          <div class="moment-tags">
            {data.tags.map((tag) => (
              <span>#{tag}</span>
            ))}
          </div>
        )}
      </section>
    ))
  }
  {moments.length === 0 && <p>这里还没有内容，慢慢积累。</p>}
</PageLayout>

<style>
  .moment {
    padding: 0 0 32px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--line);
  }
  time {
    display: block;
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 14px;
  }
  article {
    font-size: 16px;
    line-height: 1.9;
  }
  .moment-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--muted);
    font-size: 12px;
    margin-top: 16px;
  }
</style>
