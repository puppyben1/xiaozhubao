---
import PageLayout from '@layouts/PageLayout.astro'
import TechBadge from '@components/TechBadge.astro'
import { HOME, SITE, SOCIALS } from '@consts'
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <div class="profile-page">
    <h1>Hi there <span class="wave" aria-hidden="true">👋</span></h1>
    <p>你好！我是 {SITE.NAME}，欢迎来到我的个人博客。</p>

    <div class="profile-badges" aria-label="网站与项目">
      <div>
        <span>使用工具</span><TechBadge
          name="TypeScript"
          icon="/typescript.svg"
          href="https://www.typescriptlang.org/"
        /><TechBadge
          name="Astro"
          icon="/godot.svg"
          href="https://astro.build/"
        />
      </div>
      <div>
        <span>正在做</span><TechBadge
          name="个人博客"
          href="https://github.com/puppyben1/xiaozhubao"
        />
      </div>
    </div>

    <section class="profile-intro" aria-label="个人介绍">
      <p>{SITE.DESCRIPTION}</p>
      <p>
        我会在 <a href="/posts">Blog</a> 里写长文，整理学到的知识和自己的思考。也会在
        <a href="/moments">Moments</a> 分享随想，在 <a href="/photos">Photos</a> 收藏生活中的图像片段。
      </p>
      <p>把值得记住的事情留在这里，慢慢写，慢慢积累。</p>
    </section>

    <details class="profile-tags">
      <summary>🏷️ 标签：<span aria-hidden="true">⌄</span></summary>
      <div>
        {['学习', '编程', '写作', '生活记录'].map((tag) => <span>{tag}</span>)}
      </div>
    </details>

    <section class="profile-connect" aria-labelledby="connect-title">
      <h2 id="connect-title">保持联系</h2>
      <p>欢迎交流学习、项目，或者只是打个招呼。</p>
      <div class="contact-links">
        {
          SOCIALS.map((social) => (
            <a href={social.HREF} target="_blank" rel="noopener noreferrer">
              {social.NAME} ↗
            </a>
          ))
        }
        {
          SITE.EMAIL && SITE.EMAIL !== 'hi@example.com' && (
            <a href={`mailto:${SITE.EMAIL}`}>{SITE.EMAIL}</a>
          )
        }
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .profile-page {
    font-size: 1.06rem;
    line-height: 1.9;
  }
  @media (prefers-reduced-motion: no-preference) {
    .profile-page > * {
      animation: profile-enter 550ms ease both;
    }
    .profile-page > :nth-child(2) {
      animation-delay: 150ms;
    }
    .profile-page > :nth-child(3) {
      animation-delay: 300ms;
    }
    .profile-page > :nth-child(4) {
      animation-delay: 450ms;
    }
    .profile-page > :nth-child(5) {
      animation-delay: 600ms;
    }
    .profile-page > :nth-child(6) {
      animation-delay: 750ms;
    }
  }
  @keyframes profile-enter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  h1 {
    margin-bottom: 12px;
    font-size: 1.8rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.03em;
  }
  .wave {
    display: inline-block;
    margin-left: 6px;
    font-size: 1.35rem;
  }
  p {
    margin-bottom: 23.2px;
  }
  .profile-badges {
    display: grid;
    gap: 8px;
    margin: 25px 0 36px;
  }
  .profile-badges > div {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .profile-badges > div > span {
    margin-right: 3px;
  }
  .profile-intro a {
    border-bottom: 1px solid var(--line-strong);
  }
  .profile-tags {
    margin-top: 30px;
    color: var(--muted);
    font-size: 0.9rem;
  }
  summary {
    display: flex;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary > span {
    transition: transform 220ms ease;
  }
  details[open] summary > span {
    transform: rotate(180deg);
  }
  .profile-tags > div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 16px;
  }
  .profile-tags > div > span {
    padding: 2px 9px;
    border-radius: 7px;
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .profile-connect {
    margin-top: 48px;
  }
  .profile-connect::before {
    display: block;
    width: 48px;
    height: 1px;
    margin-bottom: 32px;
    background: var(--line-strong);
    content: '';
  }
  h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .profile-connect p {
    font-size: 0.93rem;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 0.9rem;
  }
</style>
