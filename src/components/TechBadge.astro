---
type Props = {
  name: string
  icon?: string
  href?: string
}

const { name, icon, href } = Astro.props

const badgeClasses = 'tech-badge'

const hoverClasses = 'tech-badge-link'
---

{
  href ? (
    <a href={href} target="_blank" class={`${badgeClasses} ${hoverClasses}`}>
      {icon && (
        <img
          alt={`${name} Logo`}
          loading="lazy"
          width="14"
          height="14"
          decoding="async"
          class="pointer-events-none"
          src={icon}
          style="color: transparent;"
        />
      )}
      {name}
    </a>
  ) : (
    <span class={badgeClasses}>
      {icon && (
        <img
          alt={`${name} Logo`}
          loading="lazy"
          width="14"
          height="14"
          decoding="async"
          class="pointer-events-none"
          src={icon}
          style="color: transparent;"
        />
      )}
      {name}
    </span>
  )
}

<style>
  .tech-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border-radius: 7.2px;
    padding: 3px 8px;
    background: color-mix(in srgb, var(--ink) 7%, transparent);
    color: var(--ink);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.5;
    text-decoration: none;
  }
  .tech-badge img {
    width: 18.4px;
    height: 18.4px;
    border-radius: 0;
  }
  .tech-badge-link {
    transition: opacity 180ms ease;
  }
  .tech-badge-link:hover {
    opacity: 0.72;
  }
</style>
