---
import ThemeToggle from '@components/ThemeToggle.astro'
import { SITE, SOCIALS } from '@consts'

const navItems = [
  {
    href: '/posts',
    label: 'Blog',
    path: 'M4 3h16v18H4z M8 7h8 M8 11h8 M8 15h5',
  },
  {
    href: '/projects',
    label: 'Projects',
    path: 'm12 3 9 5v8l-9 5-9-5V8z M3 8l9 5 9-5 M12 13v8 M7.5 5.5l9 5',
  },
  {
    href: '/photos',
    label: 'Photos',
    path: 'M8 3h13v13H8z M3 8v13h13 M8 13l4-4 3 3 3-2 3 3',
  },
  {
    href: '/friends',
    label: '友链',
    path: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8 M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75',
  },
  {
    href: '/messages',
    label: '留言板',
    path: 'M21 11.5a8.5 8.5 0 0 1-8.5 8.5H3l2-5a8.5 8.5 0 1 1 16-3.5Z',
  },
]
const pathname = Astro.url.pathname
const githubHref = SOCIALS.find((social) => social.NAME === 'GitHub')?.HREF
---

<header class="site-header">
  <nav class="site-navigation" aria-label="主导航">
    <a class="site-brand" href="/" aria-label={`${SITE.NAME} 首页`}
      >{SITE.NAME}</a
    >
    <div class="site-links">
      <a href="/moments" class="moments-link" aria-label="Moments">Moments</a>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class={
              item.href === '/posts' || item.href === '/projects'
                ? 'primary-link'
                : undefined
            }
            aria-label={item.label}
            title={item.label}
            aria-current={pathname.startsWith(item.href) ? 'page' : undefined}
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={item.path} />
            </svg>
            {(item.href === '/posts' || item.href === '/projects') && (
              <span>{item.label}</span>
            )}
          </a>
        ))
      }
      {
        githubHref && (
          <a
            class="desktop-icon"
            href={githubHref}
            aria-label="GitHub"
            title="GitHub"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M9 19c-4 1-4-2-6-2 M15 22v-4a3 3 0 0 0-1-2c4 0 6-2 6-5a5 5 0 0 0-1-3 5 5 0 0 0 0-4s-2 0-4 2a12 12 0 0 0-6 0C7 4 5 4 5 4a5 5 0 0 0 0 4 5 5 0 0 0-1 3c0 3 2 5 6 5a3 3 0 0 0-1 2v4" />
            </svg>
          </a>
        )
      }
      <a class="desktop-icon" href="/rss.xml" aria-label="RSS" title="RSS"
        ><svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><circle cx="5" cy="19" r="1"></circle><path
            d="M4 11a9 9 0 0 1 9 9 M4 4a16 16 0 0 1 16 16"></path></svg
        ></a
      >
      <div class="theme-control"><ThemeToggle /></div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(16px) saturate(1.15);
  }
  .site-navigation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1152px;
    height: 68px;
    margin: auto;
    padding: 0 24px;
    gap: 16px;
  }
  .site-brand {
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
  }
  .site-links {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .site-links > a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--muted);
    transition:
      background 180ms ease,
      color 180ms ease;
  }
  .site-links > a:hover,
  .site-links > a[aria-current] {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .primary-link span,
  .site-links > .moments-link,
  .site-links > .desktop-icon {
    display: none;
  }
  @media (min-width: 768px) {
    .site-links {
      gap: 8px;
    }
    .site-links > .primary-link {
      width: auto;
      padding: 0 8px;
      font-size: 14px;
    }
    .primary-link svg {
      display: none;
    }
    .primary-link span {
      display: inline;
    }
    .site-links > .moments-link {
      display: flex;
      width: auto;
      padding: 0 8px;
      order: 1;
      font-size: 14px;
    }
    .primary-link {
      order: 0;
    }
    .site-links > a:not(.primary-link):not(.moments-link),
    .site-links > div {
      order: 2;
    }
    .site-links > .desktop-icon {
      display: flex;
    }
  }
  @media (max-width: 380px) {
    .site-navigation {
      padding-inline: 20px;
      gap: 8px;
    }
    .site-links {
      gap: 4px;
    }
    .site-links > a {
      width: 30px;
    }
  }
</style>
